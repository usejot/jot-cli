{
  "$comment": "tools/list as the published @usejot/mcp@0.8.0 answered it: every Jot MCP server (TS jot-mcp, Rust jot mcp) must keep these names and schemas. The one intentional widening since: update_status may ask for APPROVED (the workspace policy decides).",
  "contractVersion": "0.9.0",
  "baseline": "@usejot/mcp@0.8.0",
  "tools": [
    {
      "name": "fetch_feedback",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Optional. Leave it out: the token's own project, or every project of a workspace token. Never look one up"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "RESOLVED",
              "APPROVED"
            ],
            "description": "Only return comments in this state"
          },
          "page": {
            "type": "string",
            "description": "Only comments made on this page — any URL on the page works"
          },
          "environment": {
            "type": "string",
            "description": "Only comments captured on this deployment, e.g. \"staging\""
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TEAM",
                "INVITED",
                "PUBLIC"
              ]
            },
            "minItems": 1,
            "description": "Only comments from these reporters. Omitted: public feedback still tagged FEEDBACK is left out"
          },
          "q": {
            "type": "string",
            "maxLength": 200,
            "description": "Text search over the comment and its replies"
          },
          "label": {
            "type": "string",
            "enum": [
              "BUG",
              "UI",
              "COPY",
              "CONTENT",
              "PERFORMANCE",
              "ACCESSIBILITY",
              "QUESTION",
              "ENHANCEMENT",
              "FEEDBACK"
            ],
            "description": "Only comments with this label, e.g. BUG"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "How many to return, 1–100 (default 25)"
          },
          "cursor": {
            "type": "string",
            "description": "The nextCursor of the previous page, to read on past it"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "OPEN",
                    "IN_PROGRESS",
                    "RESOLVED",
                    "APPROVED"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "TEAM",
                    "INVITED",
                    "PUBLIC"
                  ]
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "body": {
                  "type": "string"
                },
                "where": {
                  "type": "string"
                },
                "project": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "status",
                "source",
                "labels",
                "body",
                "where"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "comments",
          "nextCursor"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_comment",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "minLength": 1,
            "description": "The comment id (from fetch_feedback)"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Same as commentId"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "update_status",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "minLength": 1,
            "description": "The comment id (from fetch_feedback)"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Same as commentId"
          },
          "commentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 50,
            "description": "Several comments at once, instead of commentId"
          },
          "status": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "RESOLVED"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "updated": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "OPEN",
                    "IN_PROGRESS",
                    "RESOLVED",
                    "APPROVED"
                  ]
                }
              },
              "required": [
                "id",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "updated"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "post_reply",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "minLength": 1,
            "description": "The comment id (from fetch_feedback)"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Same as commentId"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "The note to post"
          },
          "body": {
            "$ref": "#/properties/message",
            "description": "Same as message"
          },
          "content": {
            "$ref": "#/properties/message",
            "description": "Same as message"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_batch_note",
      "inputSchema": {
        "type": "object",
        "properties": {
          "comment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "required": [
          "comment_ids",
          "message"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "replyIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "replyIds"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_projects",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "org": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "workspace"
            ]
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "dashboardUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "org",
          "scope",
          "projects",
          "dashboardUrl"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
